# Streamlit Secrets Configuration Example
#
# For Streamlit Cloud Deployment:
# 1. Go to your app settings on Streamlit Cloud
# 2. Navigate to "Secrets" section
# 3. Add the following secret:

GOOGLE_API_KEY = "your-google-gemini-api-key-here"

# For local development:
# 1. Copy this file as 'secrets.toml' (without .example)
# 2. Replace "your-google-gemini-api-key-here" with your actual API key
# 3. The secrets.toml file is gitignored and will not be committed

# Note: You can also use .env file for local development
# The app will try Streamlit secrets first, then fall back to .env
